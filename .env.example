APP_NAME="Fastnet Player"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
SITE_URL=https://fastv.fastnetperu.com.pe
STREAM_ALLOWED_HOSTS=179.63.6.214
STREAM_DIRECT_BASE=https://iptv.fastnetperu.com.pe:8099
APP_TARGET=player
# Zona horaria de las fechas guardadas. Cambiarla en una base con datos mezcla horas viejas y nuevas.
APP_TIMEZONE=UTC
# IPs de proxies de confianza (separadas por coma) o * detras de easypanel/docker. Necesario para el limite de intentos.
TRUSTED_PROXIES=*

TMDB_API_KEY=
TMDB_VERIFY_SSL=true
# Servidor Xtream unico: el cliente no puede elegir otro al iniciar sesion.
IPTV_SERVER_URL=http://iptv.fastnetperu.com.pe:80
# Admin inicial (db:seed). Si ADMIN_PASSWORD esta vacio se genera una clave al azar y se muestra una sola vez.
ADMIN_EMAIL=admin@fastnet.tv
ADMIN_PASSWORD=

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fastnet_home
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# En produccion (HTTPS): SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

XTREAM_CATALOG_SERVER_URL=
XTREAM_CATALOG_USERNAME=
XTREAM_CATALOG_PASSWORD=
VITE_HOME_API_URL=https://fastnetperu-panel-iptv.7xqmvz.easypanel.host/api/home
HOME_API_URL=https://fastnetperu-panel-iptv.7xqmvz.easypanel.host/api/home
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=
FCM_SERVER_KEY=
